{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test ui.smoke --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:watch": "playwright test ui.smoke --headed",
    "test:e2e:debug": "playwright test ui.smoke --debug",
    "lint": "ng lint",
    "prettier": "npx prettier --write .",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.25",
    "@angular/common": "^20.3.25",
    "@angular/compiler": "^20.3.25",
    "@angular/core": "^20.3.25",
    "@angular/forms": "^20.3.25",
    "@angular/platform-browser": "^20.3.25",
    "@angular/platform-server": "^20.3.33",
    "@angular/router": "^20.3.25",
    "@angular/ssr": "^20.3.38",
    "@ngrx/signals": "^20.1.0",
    "@stomp/stompjs": "^7.3.0",
    "@tailwindcss/postcss": "^4.1.17",
    "dayjs": "^1.11.19",
    "echarts": "^6.1.0",
    "express": "^5.2.1",
    "ng-zorro-antd": "^20.4.4",
    "ngx-echarts": "^22.0.0",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.6.1",
    "tailwindcss": "^4.1.17",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.25",
    "@angular/cli": "^20.3.25",
    "@angular/compiler-cli": "^20.3.25",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^26.6.4",
    "@types/sockjs-client": "^1.5.4",
    "angular-eslint": "21.0.1",
    "eslint": "^9.39.1",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "less": "^4.2.0",
    "playwright": "^1.61.1",
    "prettier": "^3.7.4",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.46.4"
  }
}