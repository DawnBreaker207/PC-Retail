# Copy sang .env và sửa các giá trị phù hợp
SERVER_PORT=8888
DB_URL=jdbc:postgresql://postgres:5432/demo?options=-c%20TimeZone%3DUTC
DB_USER=admin
DB_PASS=admin
DB_DRIVER=org.postgresql.Driver
REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
JWT_COOKIE_NAME=accessToken
JWT_REFRESH_COOKIE_NAME=refreshToken
JWT_SECRET=<your-jwt-secret>
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=86400000000
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_TMN_CODE=<your-tmn-code>
VNPAY_SECRET_KEY=<your-secret-key>
VNPAY_RETURN_URL=http://localhost:4200/api/v1/payment/callback/vnpay
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_ORDER_TYPE=other
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=<your-ai-api-key>
AI_CHAT_MODEL=openai/gpt-4o-mini
AI_EMBEDDING_MODEL=openai/text-embedding-ada-002

MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=<your-mailtrap-user>
MAIL_PASS=<your-mailtrap-pass>
MAIL_FROM=noreply@prretail.vn

FRONTEND_URL=http://localhost:4200
