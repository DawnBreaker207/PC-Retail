# Copy sang .env và sửa các giá trị phù hợp
SERVER_PORT=8888
DB_URL=jdbc:postgresql://postgres:5432/demo?options=-c%20TimeZone%3DUTC
DB_USER=admin
DB_PASS=admin
DB_DRIVER=org.postgresql.Driver
REDIS_HOST=redis
REDIS_PORT=6379
# Kafka log appender (IDE dùng localhost:29092; trong Docker dùng kafka:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_LOG_TOPIC=app-logs
SERVICE_NAME=dawn-app
# Shared token cho API /api/v1/internal/** (service-to-service)
INTERNAL_TOKEN=dev-internal-token
JWT_COOKIE_NAME=accessToken
JWT_REFRESH_COOKIE_NAME=refreshToken
# RS256 keys — sinh bằng openssl rồi copy vào đây:
#   openssl genrsa -out private.pem 2048
#   openssl pkcs8 -topk8 -nocrypt -in private.pem -outform DER | base64 -w0  → JWT_PRIVATE_KEY
#   openssl rsa -in private.pem -pubout -outform DER | base64 -w0             → JWT_PUBLIC_KEY
# Chỉ auth-service nhận JWT_PRIVATE_KEY; gateway/các service chỉ nhận JWT_PUBLIC_KEY.
JWT_PUBLIC_KEY=<base64-der-public-key>
JWT_PRIVATE_KEY=<base64-der-private-key>
JWT_KEY_ID=pc-retail
JWT_ISSUER=pc-retail
# Access token ngắn hạn; refresh token xoay vòng 7 ngày
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_TMN_CODE=<your-tmn-code>
VNPAY_SECRET_KEY=<your-secret-key>
VNPAY_RETURN_URL=http://localhost:4200/api/v1/payment/callback/vnpay
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_ORDER_TYPE=other
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=<your-ai-api-key>
AI_CHAT_MODEL=openai/gpt-4o-mini
AI_EMBEDDING_MODEL=openai/text-embedding-ada-002

MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=<your-mailtrap-user>
MAIL_PASS=<your-mailtrap-pass>
MAIL_FROM=noreply@prretail.vn

FRONTEND_URL=http://localhost:4200
